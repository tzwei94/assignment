{
  "id": null,
  "uid": "banking-api-service-graph",
  "title": "Banking API \u00b7 Service Graph",
  "description": "Trace-derived dependencies, request rates, errors and latency from Tempo service graphs. Includes health checks and sampled traces.",
  "tags": [
    "banking",
    "observability",
    "service-graph"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "API Overview",
      "type": "link",
      "url": "/d/banking-api-overview",
      "keepTime": true
    },
    {
      "title": "Log Search",
      "type": "link",
      "url": "/d/banking-api-logs",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Banking API dependencies",
      "type": "nodeGraph",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "description": "Trace-derived dependency map. Database spans create a virtual database node; user represents uninstrumented callers. Includes health checks and sampled traffic. Click nodes to explore traces. Metrics begin when generation is enabled; historical traces are not backfilled.",
      "options": {},
      "targets": [
        {
          "refId": "A",
          "queryType": "serviceMap",
          "serviceMapQuery": [
            "{client=\"banking-api\"}",
            "{server=\"banking-api\"}"
          ],
          "serviceMapIncludeNamespace": false,
          "serviceMapUseNativeHistograms": false
        }
      ]
    },
    {
      "id": 2,
      "title": "Dependency requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{client=\"banking-api\",source=\"tempo\"}[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Dependency error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (client, server) (rate(traces_service_graph_request_failed_total{client=\"banking-api\",source=\"tempo\"}[$__rate_interval])) or (sum by (client, server) (rate(traces_service_graph_request_total{client=\"banking-api\",source=\"tempo\"}[$__rate_interval])) * 0)) / (sum by (client, server) (rate(traces_service_graph_request_total{client=\"banking-api\",source=\"tempo\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true
        }
      ],
      "description": "Missing failure series count as zero only when a corresponding request series exists. Idle dependencies remain undefined."
    },
    {
      "id": 4,
      "title": "Dependency latency \u00b7 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (client, server, le) (rate(traces_service_graph_request_client_seconds_bucket{client=\"banking-api\",source=\"tempo\"}[$__rate_interval])))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true
        }
      ],
      "description": "Approximate histogram quantile using millisecond-scale latency buckets; not an exact percentile."
    },
    {
      "id": 5,
      "title": "Dependency latency \u00b7 mean",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (client, server) (rate(traces_service_graph_request_client_seconds_sum{client=\"banking-api\",source=\"tempo\"}[$__rate_interval])) / sum by (client, server) (rate(traces_service_graph_request_client_seconds_count{client=\"banking-api\",source=\"tempo\"}[$__rate_interval]))",
          "legendFormat": "{{client}} \u2192 {{server}}",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Reading this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Trace-derived traffic:** rates include readiness/database checks and reflect the configured trace sampling. Use the [Overview](/d/banking-api-overview) for HTTP application traffic and [Log Search](/d/banking-api-logs) for logs.\n\nThe PostgreSQL endpoint is a virtual dependency inferred from JDBC spans, not an independently instrumented database service. Blank latency/error ratios during idle periods are expected. New service-graph metrics are generated from incoming traces only."
      }
    }
  ]
}
