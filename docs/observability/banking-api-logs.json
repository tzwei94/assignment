{
  "description": "Filter application logs by operation, severity, task and literal message text. Expand a row for parsed fields including trace_id. Operation filters match text; accepted operations are logged, rejected requests and idempotent retries may not have an operation message.",
  "editable": true,
  "id": null,
  "links": [
    {
      "keepTime": true,
      "targetBlank": false,
      "title": "API overview",
      "type": "link",
      "url": "/d/banking-api-overview"
    },
    {
      "keepTime": true,
      "title": "Service Graph",
      "type": "link",
      "url": "/d/banking-api-service-graph"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Newest first, up to 1,000 matching logs. Search is case-sensitive literal text. Empty search shows all messages. Expand a row for severity, task and trace ID. Do not include backticks in the search text.",
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{service_name=\"banking-api\",environment=~\"${environment:regex}\",instance=~\"${instance:regex}\"} | json | __error__=\"\" | level=~\"${level:regex}\" | message=~\"(?s).*${operation:regex}.*\" | line_format \"{{.message}}\" |= `${search:raw}`",
          "maxLines": 1000,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Messages",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "banking",
    "logs"
  ],
