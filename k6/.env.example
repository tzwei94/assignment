# Local shell configuration. Quote credentials with single quotes.
# For the deployed demo, replace BASE_URL with https://bnk-api.tzwei.me.
BASE_URL='http://localhost:8080'
TOKEN_USERNAME=''
TOKEN_PASSWORD=''
ACCOUNT_IDS='00000000-0000-0000-0000-000000000001'
CURRENCY='SGD'

# Mixed: GET each iteration, plus a deposit/withdrawal pair every fifth iteration.
# Use WORKLOAD=balance and ALLOW_WRITES=false for read-only testing.
# Use WORKLOAD=cpu for POST /demo/cpu; stress selects the bounded CPU load profile.
WORKLOAD='mixed'
ALLOW_WRITES='true'
WRITE_EVERY='5'
AMOUNT='0.01'

RATE='10'
PRE_ALLOCATED_VUS='20'
MAX_VUS='200'
STRESS_RATES='10,25,50,100'
RAMP_DURATION='30s'
HOLD_DURATION='1m'
P95_MS='500'
ERROR_RATE='0.01'
REQUEST_TIMEOUT='10s'
# DURATION='5m'  # load defaults to 5m; soak defaults to 30m.

# CPU demo settings: used only with WORKLOAD=cpu.
# One job per task, 500 ms max work, four CPU requests/sec for five minutes.
CPU_WORK_MS='500'
CPU_RATE='4'
CPU_MAX_VUS='8'
CPU_DURATION_SECONDS='300'

# Local k6 dashboard; the runners place report.html in each run's report directory.
K6_WEB_DASHBOARD='true'
K6_WEB_DASHBOARD_OPEN='true'
K6_WEB_DASHBOARD_HOST='127.0.0.1'
K6_WEB_DASHBOARD_PORT='5665'
K6_WEB_DASHBOARD_EXPORT='report.html'
